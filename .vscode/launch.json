{
    "version": "0.2.0",
    "configurations": [
      {
        "name": "Python: FastAPI Backend",
        "type": "debugpy",
        "request": "launch",
        "module": "uvicorn",
        "args": [
          "src.main:app",
          "--reload",
          "--port",
          "8000"
        ],
        "jinja": true,
        "justMyCode": false,
        "cwd": "${workspaceFolder}/apps/backend",
        "env": {
          "PYTHONPATH": "${workspaceFolder}/apps/backend/src"
        },
        "python": "${workspaceFolder}/apps/backend/.venv/Scripts/python.exe"
      }
    ]
  }